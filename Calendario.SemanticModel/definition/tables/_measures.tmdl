			//         -- Ordena por Tipo (Feriado antes de Ponto Facultativo) e limita a 4 bolinhas
			//         VAR Top4 = TOPN(4, EvsDia, tb_Feriados[Tipo], ASC, tb_Feriados[Nome_Feriado], ASC)
			//         VAR Bolinhas =
			//             IF(QtdEvs > 0,
			//                 "<div class='dots'>" &
			//                 CONCATENATEX(
