			//         "<div class='dc muted'></div>",
			//         ""
			//     )
			
			// VAR Dias =
			//     CONCATENATEX(
			//         GENERATESERIES(1, TotalDias),
			//         VAR D      = [Value]
			//         VAR EvsDia = FILTER(TabEventosMes, DAY(tb_Feriados[Data]) = D)
			//         VAR QtdEvs = COUNTROWS(EvsDia)
			
			//         VAR TemFer = COUNTROWS(FILTER(EvsDia, tb_Feriados[Tipo] = "Feriado")) > 0
			//         VAR TemPF  = COUNTROWS(FILTER(EvsDia, tb_Feriados[Tipo] = "Ponto Facultativo")) > 0
			
			//         -- Feriado tem prioridade sobre Ponto Facultativo; dia sem evento fica sem classe
			//         VAR BgClass =
			//             SWITCH(
			//                 TRUE(),
			//                 TemFer, " has-feriado",
			//                 TemPF,  " has-pf",
			//                 ""
