	column 'Nome do dia'
		dataType: string
		lineageTag: a33eece1-d2ad-4f89-a47d-c91905272579
		summarizeBy: none
		sourceColumn: Nome do dia

		annotation SummarizationSetBy = Automatic

	partition Calendar = m
		mode: import
		source =
				let
				    AnoAtual = Date.Year(DateTime.LocalNow()),
				    DataInicial = #date(AnoAtual, 1, 1),
				    DataFinal   = #date(AnoAtual+2, 12, 31),
				    QtdDias     = Duration.Days(DataFinal - DataInicial) + 1,
				
				    Datas   = List.Dates(DataInicial, QtdDias, #duration(1, 0, 0, 0)),
				    Tabela  = Table.FromList(Datas, Splitter.SplitByNothing(), {"Data"}, null, ExtraValues.Error),
				    Tipada  = Table.TransformColumnTypes(Tabela, {{"Data", type date}}),
				
				    Ano     = Table.AddColumn(Tipada, "Ano", each Date.Year([Data]), Int64.Type),
				    MesNum  = Table.AddColumn(Ano, "MesNum", each Date.Month([Data]), Int64.Type),
				    Mes     = Table.AddColumn(MesNum, "Mes", each Text.Proper(Date.MonthName([Data], "pt-BR")), type text),
				  #"Dia inserido" = Table.AddColumn(Mes, "Dia", each Date.Day([Data]), type nullable number),
				  #"Nome do dia inserido" = Table.AddColumn(#"Dia inserido", "Nome do dia", each Date.DayOfWeekName([Data], "pt-BR"), type nullable text)
				in
				    #"Nome do dia inserido"

	annotation PBI_ResultType = Table

