			//                 "</div>",
			//                 ""
			//             )
			
			//         VAR TipContent =
			//             IF(QtdEvs > 0,
			//                 CONCATENATEX(
			//                     EvsDia,
			//                     "<div class='tr'>" &
			//                     "<span class='dot' style='background:" &
			//                         IF(tb_Feriados[Tipo] = "Feriado", "#ef4444", "#f59e0b") &
			//                     "'></span>" &
			//                     "<strong>" & tb_Feriados[Tipo] & ":</strong>" &
			//                     "<em>" & tb_Feriados[Nome_Feriado] & "</em>" &
			//                     "</div>",
			//                     "",
