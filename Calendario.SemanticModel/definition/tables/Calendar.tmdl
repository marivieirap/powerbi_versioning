		variation Variation
			isDefault
			relationship: 780e48ca-5e70-4e3c-8727-8d92635b9748
			defaultHierarchy: LocalDateTable_0d40e6dd-c7ed-450e-bb2c-b66afb83fd31.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

